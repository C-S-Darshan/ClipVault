# Supabase Configuration
# Obtain these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Production site URL (e.g., https://your-app.vercel.app)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional: Supabase Service Role Key (for administrative tasks / user approvals)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Custom YouTube Data API v3 key if you prefer direct API over oEmbed
# YOUTUBE_API_KEY=your-youtube-api-key-here

